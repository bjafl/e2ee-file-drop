[
  {
    "corsRuleName": "allow-e2ee-uploads",
    "allowedOrigins": [
      "https://your-site.netlify.app",
      "https://deploy-preview-*.your-site.netlify.app",
      "http://localhost:8888",
      "http://localhost:5173"
    ],
    "allowedOperations": [
      "s3_get",
      "s3_put"
    ],
    "allowedHeaders": ["*"],
    "exposeHeaders": ["ETag", "x-amz-request-id"],
    "maxAgeSeconds": 3600
  }
]