[
  {
    "corsRuleName": "allowNetlifyApp",
    "allowedOrigins": [
      "https://e2ee-file-drop.netlify.app"
    ],
    "allowedOperations": [
      "b2_upload_file",
      "b2_upload_part",
      "b2_download_file_by_name",
      "b2_download_file_by_id",
      "s3_put",
      "s3_get",
      "s3_head",
      "s3_delete"
    ],
    "allowedHeaders": [
      "authorization",
      "content-type",
      "content-length",
      "content-md5",
      "content-disposition",
      "cache-control",
      "x-amz-*",
      "x-bz-file-name",
      "x-bz-content-sha1",
      "x-bz-info-*",
      "range",
      "if-match",
      "if-none-match",
      "if-modified-since",
      "if-unmodified-since"
    ],
    "exposeHeaders": [
      "etag",
      "x-amz-request-id",
      "x-amz-id-2",
      "x-amz-version-id",
      "x-bz-content-sha1",
      "x-bz-file-id",
      "x-bz-file-name",
      "x-bz-upload-timestamp",
      "content-length",
      "content-type"
    ],
    "maxAgeSeconds": 3600
  }
]